ine":1,"column":2354}},{"source":"index.js","name":"classList","original":{"line":136,"column":12},"generated":{"line":1,"column":2362}},{"source":"index.js","name":"add","original":{"line":136,"column":22},"generated":{"line":1,"column":2372}},{"source":"index.js","original":{"line":136,"column":26},"generated":{"line":1,"column":2376}},{"source":"index.js","name":"leave","original":{"line":140,"column":4},"generated":{"line":1,"column":2388}},{"source":"index.js","name":"leave","original":{"line":141,"column":2},"generated":{"line":1,"column":2391}},{"source":"index.js","name":"addEventListener","original":{"line":141,"column":8},"generated":{"line":1,"column":2393}},{"source":"index.js","original":{"line":141,"column":25},"generated":{"line":1,"column":2410}},{"source":"index.js","original":{"line":141,"column":34},"generated":{"line":1,"column":2418}},{"source":"index.js","name":"socket","original":{"line":142,"column":4},"generated":{"line":1,"column":2429}},{"source":"index.js","name":"emit","original":{"line":142,"column":11},"generated":{"line":1,"column":2431}},{"source":"index.js","original":{"line":142,"column":16},"generated":{"line":1,"column":2436}}],"sources":{"index.js":"const socket = io();\r\n// Game screen elements\r\nconst username = document.getElementById(\"name-input\");\r\nconst messageContainer = document.getElementById(\"message-container\");\r\nconst messageForm = document.getElementById(\"message-form\");\r\nconst messageInput = document.getElementById(\"message-input\");\r\nconst setQuestionBtn = document.getElementById(\"setQuestionBtn\");\r\nconst submitQA = document.getElementById(\"submitQA\");\r\nconst closePopover = document.getElementById(\"closePopover\");\r\nconst leave = document.getElementById(\"leave\");\r\nconst answerTone = new Audio(\"/answer.wav\");\r\nconst questionTone = new Audio(\"/question.wav\");\r\n\r\n// ---- Chat & Game Events ----\r\nif (messageContainer && messageForm) {\r\n  messageForm.addEventListener(\"submit\", (e) => {\r\n    e.preventDefault();\r\n    sendMessage();\r\n  });\r\n\r\n  socket.on(\"session_created\", (data) => {\r\n    username.innerText = `${data}`;\r\n    clearTopFeedback();\r\n    feedbackTop(true, data);\r\n  });\r\n\r\n  socket.on(\"player_joined\", (data) => {\r\n    username.innerText = `${data}`;\r\n    clearTopFeedback();\r\n    feedbackTop(false, data);\r\n  });\r\n\r\n  socket.on(\"question_created\", (data) => {\r\n    const question = document.getElementById(\"message-left\");\r\n    question.innerHTML = `${data}`;\r\n  });\r\n\r\n  socket.on(\"correct_answer\", (data) => {\r\n    answerTone.play();\r\n    addMessageToUI(false, data);\r\n  });\r\n\r\n  socket.on(\"question_created\", (question) => {\r\n    questionTone.play();\r\n    addMessageToUI(false, question);\r\n  });\r\n\r\n  socket.on(\"session_restarted\", (data) => {\r\n    feedback(data);\r\n  });\r\n\r\n  socket.on(\"player_left\", (data) => {\r\n    feedback(data);\r\n  });\r\n\r\n  socket.on(\"session_deleted\", (data) => {\r\n    feedback(data);\r\n  });\r\n\r\n  const sendMessage = () => {\r\n    if (messageInput.value === \"\") return;\r\n    const data = { guess: messageInput.value, datetime: Date.now() };\r\n\r\n    socket.emit(\"guess_answer\", data);\r\n    addMessageToUI(true, data);\r\n    messageInput.value = \"\";\r\n  };\r\n\r\n  const addMessageToUI = (isOwnedMessage, data) => {\r\n    const element = `\r\n      <li class=\"${isOwnedMessage ? \"message-right\" : \"message-left\"}\">\r\n        <p class=\"message\">\r\n          ${isOwnedMessage ? data.guess : data.message}\r\n          <span>${isOwnedMessage ? \"\" : data.username} • ${moment(\r\n      data.datetime\r\n    ).fromNow()}</span>\r\n        </p>\r\n      </li>`;\r\n    messageContainer.innerHTML += element;\r\n    messageContainer.scrollTo(0, messageContainer.scrollHeight);\r\n  };\r\n\r\n  const feedbackTop = (is_host, data) => {\r\n    const element = `\r\n      <li class=\"message-feedback-top\">\r\n        <p class=\"feedback-top\">${data} ${\r\n      is_host ? \"is the host\" : \"joined\"\r\n    }</p>\r\n      </li>`;\r\n    messageContainer.innerHTML += element;\r\n  };\r\n\r\n  const clearTopFeedback = () => {\r\n    document\r\n      .querySelectorAll(\"li.message-feedback-top\")\r\n      .forEach((el) => el.remove());\r\n  };\r\n\r\n  const feedback = (data) => {\r\n    const element = `\r\n      <li class=\"message-feedback-top\">\r\n        <p class=\"feedback-top\">${data} joined</p>\r\n      </li>`;\r\n    messageContainer.innerHTML += element;\r\n  };\r\n}\r\n\r\n// ---- Game Master Controls ----\r\nif (setQuestionBtn) {\r\n  setQuestionBtn.addEventListener(\"click\", () => {\r\n    document.getElementById(\"popover\").classList.remove(\"hidden\");\r\n  });\r\n\r\n  socket.on(\"assignGameMaster\", (isGameMaster) => {\r\n    setQuestionBtn.style.display = isGameMaster ? \"block\" : \"none\";\r\n  });\r\n}\r\n\r\nif (submitQA) {\r\n  submitQA.addEventListener(\"click\", () => {\r\n    const question = questionInput.value.trim();\r\n    const answer = answerInput.value.trim();\r\n    if (!question || !answer) return alert(\"Please enter both!\");\r\n\r\n    socket.emit(\"set_question\", { question, answer });\r\n\r\n    questionInput.value = \"\";\r\n    answerInput.value = \"\";\r\n    popover.classList.add(\"hidden\");\r\n    setQuestionBtn.style.display = \"none\";\r\n  });\r\n}\r\n\r\nif (closePopover) {\r\n  closePopover.addEventListener(\"click\", () => {\r\n    popover.classList.add(\"hidden\");\r\n  });\r\n}\r\n\r\nif (leave) {\r\n  leave.addEventListener(\"click\", () => {\r\n    socket.emit(\"disconnect\");\r\n  });\r\n}\r\n"},"lineCount":null}},"error":null,"hash":"b07b176b6153aa81e68522f022f660c9","cacheData":{"env":{}}}